+def _pep440_release_tuple(version: str) -> tuple[int, ...]:
+    """Numeric release prefix of a pip/torch version (``2.11.0+cu128`` → ``(2, 11, 0)``)."""
+    core = version.split("+", 1)[0].strip()
+    parts: list[int] = []
+    for token in core.split("."):
+        digits = ""
+        for char in token:
+            if char.isdigit():
+                digits += char
+            else:
+                break
+        if not digits:
+            break
+        parts.append(int(digits))
+    return tuple(parts)
+
